nvim/nvim/plugin/

# Zsh local overrides (secrets, host-specific config)
zsh/.zshenv.local

# Sisyphus agent drafts and plans
.sisyphus/

# Vim plugin directory - installed by vim-plug
vim/.vim/plugged/

# OMC (OhMyOpenCode) state files
.omc/

# Vite build output
dist/
.vite/

# Understand-Anything generated files
.understand-anything/

# macOS metadata files
.DS_Store

# Machine-local state (not tracked in dotfiles)
omp/.omp/agent/*.db
omp/.omp/agent/*.db-shm
omp/.omp/agent/*.db-wal
omp/.omp/agent/sessions/
omp/.omp/agent/terminal-sessions/
omp/.omp/agent/blobs/
omp/.omp/agent/cache/
omp/.omp/agent/memories/
omp/.omp/agent/last-changelog-version
omp/.omp/cache/
omp/.omp/puppeteer/
omp/.omp/run/
omp/.omp/gpu_cache.json
omp/.omp/logs/
omp/.omp/natives/

# Nested clone of the rtk-extension repo (own git history)
omp/omp-rtk-extension/

# Claude agent state (untracked local state)
claude/

# omp lock files
*.lock
omarchy-legacy-backup/

# Pen (pen.dev) — only models.json is synced; everything else under the pen/
# package is machine state or secrets. Guards against folding ~/.pencil into the
# repo (which would drag live tokens in) and against a stray `git add`.
pen/.pencil/*
!pen/.pencil/models.json

# Hermes (hermes/.hermes is stowed to ~/.hermes) — the app writes runtime state
# and a .env next to the tracked config. Keep those out of the repo in case the
# dir is ever folded into a symlink.
hermes/.hermes/.env
hermes/.hermes/*.lock
hermes/.hermes/*.db
hermes/.hermes/*.db-*
hermes/.hermes/.skills_prompt_snapshot.json
hermes/.hermes/.hermes-update-*
hermes/.hermes/.mcp-discovery.lock
hermes/.hermes/.npm_lock_hash_*
