nvim/nvim/plugin/

# Zsh local overrides (secrets, host-specific config)
zsh/.zshenv.local

# Sisyphus agent drafts and plans
.sisyphus/

# Vim plugin directory - installed by vim-plug
vim/.vim/plugged/

# OMC (OhMyOpenCode) state files
.omc/

# Vite build output
dist/
.vite/

# Understand-Anything generated files
.understand-anything/

# macOS metadata files
.DS_Store

# Machine-local state (not tracked in dotfiles)
omp/.omp/agent/*.db
omp/.omp/agent/*.db-shm
omp/.omp/agent/*.db-wal
omp/.omp/agent/sessions/
omp/.omp/agent/terminal-sessions/
omp/.omp/agent/custom-session-files/
omp/.omp/agent/blobs/
omp/.omp/agent/cache/
omp/.omp/agent/memories/
omp/.omp/agent/predict/
omp/.omp/agent/last-changelog-version
omp/.omp/cache/
omp/.omp/puppeteer/
omp/.omp/run/
omp/.omp/gpu_cache.json
omp/.omp/logs/
omp/.omp/natives/

# Nested clone of the rtk-extension repo (own git history)
omp/omp-rtk-extension/

# Claude Code (claude/ is a stow package): track only the config Claude reads
# and the jev-router plugin. Auth, transcripts, caches and installed-plugin
# state under ~/.claude are machine-local and never tracked.
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/mcp.json.template
!claude/.claude/skills/
claude/.claude/skills/*
!claude/.claude/skills/jev-router/

# omp lock files
*.lock
omarchy-legacy-backup/

# Pen (pen.dev) — only models.json is synced; everything else under the pen/
# package is machine state or secrets. Guards against folding ~/.pencil into the
# repo (which would drag live tokens in) and against a stray `git add`.
pen/.pencil/*
!pen/.pencil/models.json

# dsh (DeepSeek Harness). Stowed from dsh/: the home-level cordis.patch.yml,
# the systemd unit, and the env template. Everything else under ~/.dsh is
# machine state or secrets: logs/ holds startup diagnostics that can echo
# credential values, and .credentials.yaml holds provider keys. Guards against
# folding ~/.dsh into the repo and against a stray `git add`. The live service
# env is deployed by dsh/install.sh.
dsh/.dsh/*
!dsh/.dsh/cordis.patch.yml
dsh/.dsh/.credentials.yaml
dsh/.dsh/.env
dsh/.dsh/logs/

# dsh profiles: the harness config itself, tracked as a SEED rather than a
# symlink. dsh commits config writes with writeFileAtomic, which renames a temp
# file over the target — rename() replaces a symlink instead of writing through
# it, so stowing these would silently sever the link on the first settings save
# or `dsh plugin add`. install.sh copies them in; `install.sh --capture` pulls
# live edits back. Only intent files are tracked: pnpm-lock.yaml is derived from
# package.json + plugins.txt and churns on every install.
!dsh/.dsh/profiles/
dsh/.dsh/profiles/*
!dsh/.dsh/profiles/*/
!dsh/.dsh/profiles/*/cordis.patch.yml
!dsh/.dsh/profiles/*/package.json
!dsh/.dsh/profiles/*/pnpm-workspace.yaml
!dsh/.dsh/profiles/*/compatibility.json
dsh/.dsh/profiles/**/node_modules/
dsh/.dsh/profiles/**/pnpm-lock.yaml
dsh/.dsh/profiles/**/*.bak-*
dsh/.dsh/profiles/**/package.json.lock
dsh/.dsh/profiles/**/.plugin-manager/
dsh/.dsh/profiles/**/.srprobe

# Hyprland Lua port: only the live overrides under hypr-lua/ are versioned
hypr-lua/standalone/
hypr-lua/APPLY.md
hypr-lua/apply.sh
# The real service env holds provider keys and bot tokens, and web.env names
# addresses that resolve on exactly one host; only the templates are committed.
# Deployed by dsh/install.sh (copied, never symlinked).
dsh/.config/dsh/env
dsh/.config/dsh/web.env

# Machine-local nginx listeners: the tracked vhosts `include` a per-host snippet
# glob, so a tailnet/LAN address never lands in the repo.
dsh/etc/nginx/snippets/dsh-tailnet-*.conf
9router/etc/nginx/snippets/ai-tailnet-*.conf

hypr-lua/fix-snapper.sh

# Third-party agent skills (mattpocock/skills et al) installed with
# `npx skills add <owner>/<repo>`. They are MIT-licensed upstream, but they are
# not ours to redistribute from this public repo, so the working tree keeps them
# while git ignores them. Skills — and the lock that pins them — are managed in
# the separate ekajaya740/skills collection repo (~/skills), not here.
.agents/skills/
skills-lock.json

# Python bytecode from the repo's own scripts (scripts/release_dotfiles.py)
__pycache__/
*.pyc
