# dsh-web-cookie.service — re-mint the nginx-injected dsh browser-session cookie.
#
# The dsh Web UI authenticates with an authority-bound signed cookie whose
# signing secret is durable but whose issue/expiry window is absolute. This
# regenerates one snippet per served authority (dsh.workofekajaya.com, and
# magicdns.example.ts.net:8444) via the script's own passwordless sudo, so
# both plain URLs keep working across dsh restarts without any ?token= URL.
#
# Stowed from dotfiles/dsh/ to ~/.config/systemd/user/dsh-web-cookie.service.
[Unit]
Description=Refresh the dsh Web UI nginx cookie snippets
After=network-online.target

[Service]
Type=oneshot
# ~/bin/dsh-web-cookie-refresh is the stow link into dotfiles/dsh/bin, so the
# repo stays the single source of truth; a copy under ~/.local/bin would drift.
ExecStart=/home/user/bin/dsh-web-cookie-refresh
