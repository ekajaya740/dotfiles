# dsh-superagent-check.service — one hourly health check of the
# dsh-superagent-personal instance (port 3091).
#
# DSH_HOME and the profile name must match dsh-superagent-personal.service, or
# this composes the wrong profile and reports a healthy instance as down.
#
# Runs OUTSIDE the superagent profile on purpose: the check must keep working
# when that service is down. It reports a part that errored or setup that needs a
# person without restarting, and restarts only a service that is not answering.
#
# It defers to systemd when a unit supervises the profile
# (dsh-superagent-personal.service), so it never races Restart=always or starts a
# competing tmux instance.
#
# Reports go to the journal and are de-duplicated across runs, so one persistent
# problem is told once rather than every hour:
#   journalctl --user -u dsh-superagent-personal-check
# Set DSH_SUPERAGENT_NOTIFY to a command (e.g. a chat-bot sender) to deliver
# reports somewhere you actually read; it receives the text on stdin.
[Unit]
Description=Hourly health check of the dsh-superagent-personal instance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/dsh-superagent
Environment="PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="DSH_HOME=%h/.dsh-superagent-personal"
# A restart waits for Executors to finish their step, so this must outlast that wait.
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
ExecStart=%h/work/dsh-superagent/scripts/dsh-superagent-check --profile superagent-personal
