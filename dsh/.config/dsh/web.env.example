# dsh web daemon — per-machine proxy authorities.
#
# Copy to ~/.config/dsh/web.env and fill in this host's values. The real file is
# machine-local and MUST NOT be committed: it names addresses that resolve on
# exactly one box (a tailnet MagicDNS name, a LAN name, a second port). .gitignore
# covers it.
#
#   cp dsh/.config/dsh/web.env.example ~/.config/dsh/web.env
#   chmod 600 ~/.config/dsh/web.env
#
# Both dsh-web.service and dsh-web-cookie.service load this file, so the listener
# dsh trusts and the cookie the refresh script mints cannot drift apart. It is
# optional (`EnvironmentFile=-`): with no file, the public hostname is still
# trusted and still gets its snippet.

# Extra authorities dsh should trust behind nginx, appended to the unit's
# ExecStart. One or more `--trusted-host <authority>` pairs, space separated.
# systemd splits an unquoted $VAR into words, so no quoting is needed here.
# Leave unset on a host that serves only the public listener.
#
#   DSH_WEB_EXTRA_ARGS=--trusted-host dsh.example.ts.net:8444
#
# The authority must match what nginx forwards verbatim, port included: the
# browser-trust fence compares `new URL(Origin).host` byte-for-byte against the
# request Host.
# DSH_WEB_EXTRA_ARGS=--trusted-host <magicdns-name>:8444

# Authorities dsh-web-cookie-refresh should mint a cookie snippet for, beyond the
# public hostname it always mints. Space-separated `<authority> <snippet>` pairs;
# the snippet name must match the `include` in the server block that serves that
# authority. One snippet per authority is required because the cookie NAME hashes
# the authority.
#
#   DSH_WEB_AUTHORITIES="host.example.com:8444 dsh-web-cookie-tailnet.conf"
# DSH_WEB_AUTHORITIES="<magicdns-name>:8444 dsh-web-cookie-tailnet.conf"
