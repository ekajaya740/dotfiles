# dsh web daemon — service env template.
#
# Copy to ~/.config/dsh/env and fill in the values. The real file is
# machine-local and MUST NOT be committed: it holds provider keys and bot
# tokens. .gitignore covers it.
#
#   cp dsh/.config/dsh/env.example ~/.config/dsh/env
#   chmod 600 ~/.config/dsh/env
#
# Referenced by dsh-web.service as EnvironmentFile. Kept separate from
# ~/.hermes/.env so the harness does not inherit Hermes's telegram/discord/r2/
# notion secrets.

# Telemetry off by default.
DSH_TELEMETRY_DISABLED=1

# LoopX plugin bootstrap needs Python 3.11+ WITH pip. The plugin probes
# `python3` on PATH and fails closed (silently) when pip is missing — the web UI
# still comes up, so the failure is easy to miss. Point this at an interpreter
# that has pip if the system python3 does not.
#   verify: "$PYTHON_BIN" -m pip --version
# PYTHON_BIN=/path/to/python3

# Provider / service keys — set your own.
NINEROUTER_API_KEY=
HEVY_API_KEY=
TELEGRAM_BOT_TOKEN=
