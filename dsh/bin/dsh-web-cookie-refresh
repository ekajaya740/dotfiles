#!/usr/bin/env bash
# dsh-web-cookie-refresh — keep the nginx-injected dsh browser-session cookie fresh.
#
# The dsh Web UI authenticates every /api call and WebSocket stream with an
# authority-bound signed cookie. Its *signing secret* is durable (the
# `client-connection/browser-session` record in $DSH_HOME/.credentials.yaml),
# but the cookie's own issue/expiry window is absolute, so a cookie eventually
# ages out even though the secret never changes.
#
# This re-mints one cookie per served authority and installs each as an nginx
# snippet that the matching server block sends as the request `Cookie` header,
# so the UI needs no per-boot `?token=` URL and that survives every restart.
#
# One snippet PER AUTHORITY, never one shared file: the cookie name is
# `dsh-auth-<base64url sha256(authority)>`, so a cookie signed for the public
# hostname is ignored on any second authority. Sharing a snippet would silently
# break whichever authority minted last.
#
# Authorities beyond the public hostname are per machine, so they come from the
# environment:
#
#   DSH_WEB_AUTHORITIES="<authority> <snippet> <authority> <snippet>"
#
# Space-separated `<authority> <snippet-basename>` pairs, set in
# ~/.config/dsh/web.env (template: dsh/.config/dsh/web.env.example), which the
# timer's unit loads. The public authority below is always minted, so a host
# with no web.env still gets its primary snippet: a missing env file degrades to
# "extra authorities absent", never to "no snippet at all".
#
# Run by dsh-web-cookie.timer; safe to run by hand at any time.
set -euo pipefail

DAYS="${DSH_WEB_COOKIE_DAYS:-25}"
CREDS="${DSH_HOME:-$HOME/.dsh}/.credentials.yaml"
SNIPPET_DIR="${DSH_WEB_COOKIE_DIR:-/etc/nginx/snippets}"

# Source the per-host authority list when run by hand. The systemd unit sets it
# via EnvironmentFile, but AGENTS.md tells the operator to run this by hand
# during install, and an interactive shell has no EnvironmentFile. Sourcing is
# idempotent: a value already exported wins, because the file only sets what
# this host needs and the timer's EnvironmentFile takes precedence anyway.
DSH_WEB_ENV="${DSH_WEB_ENV:-$HOME/.config/dsh/web.env}"
if [ -r "$DSH_WEB_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$DSH_WEB_ENV"
  set +a
fi

# The authority the public vhost always serves. Renamable for a fork that moves
# the domain, but not host-specific, so it does not live in web.env.
PUBLIC_AUTHORITY="${DSH_WEB_PUBLIC_AUTHORITY:-dsh.workofekajaya.com}"

# authority [snippet basename] — the authority must be exactly what dsh reads
# back from the Host header (`new URL("http://" + host).host`), port included
# when nginx passes the port through.
AUTHORITIES=("$PUBLIC_AUTHORITY dsh-web-cookie.conf")
if [ -n "${DSH_WEB_AUTHORITIES:-}" ]; then
  read -r -a _extra <<<"$DSH_WEB_AUTHORITIES"
  for ((_i = 0; _i + 1 < ${#_extra[@]}; _i += 2)); do
    AUTHORITIES+=("${_extra[_i]} ${_extra[_i + 1]}")
  done
fi

# Root (the timer) installs directly; a normal user goes through sudo.
if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo -n"; fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

for entry in "${AUTHORITIES[@]}"; do
  read -r authority snippet <<<"$entry"

  python3 - "$authority" "$DAYS" "$CREDS" >"$tmp/$snippet" <<'PY'
import base64, hashlib, hmac, json, sys, time

authority, days, creds = sys.argv[1], int(sys.argv[2]), sys.argv[3]

# Pull the durable signing secret out of the browser-session grant record.
secret_b64 = None
in_record = False
with open(creds, encoding="utf-8") as handle:
    for line in handle:
        stripped = line.strip()
        if stripped.endswith("client-connection/browser-session:"):
            in_record = True
            continue
        if in_record:
            if stripped.startswith("secret:"):
                secret_b64 = stripped.split(":", 1)[1].strip()
                break
            if stripped and not line.startswith((" ", "\t")):
                in_record = False
if not secret_b64:
    sys.exit("dsh-web-cookie-refresh: no browser-session secret in %s" % creds)

b64e = lambda raw: base64.urlsafe_b64encode(raw).decode().rstrip("=")
secret = base64.urlsafe_b64decode(secret_b64 + "=" * (-len(secret_b64) % 4))

now = int(time.time() * 1000)
payload = {
    "version": 1,
    "authority": authority,
    "issuedAt": now,
    "expiresAt": now + days * 86400 * 1000,
}
body = b64e(json.dumps(payload, separators=(",", ":")).encode())
sig = b64e(hmac.new(secret, body.encode(), hashlib.sha256).digest())
name = "dsh-auth-" + b64e(hashlib.sha256(authority.encode()).digest())

print('proxy_set_header Cookie "%s=v1.%s.%s";' % (name, body, sig))
PY

  $SUDO install -o root -g root -m 600 "$tmp/$snippet" "$SNIPPET_DIR/$snippet"
done

# One validation and one reload for every snippet written above.
$SUDO nginx -t
$SUDO nginx -s reload
