{
  "name": "dsh-system-monitor",
  "version": "0.1.0",
  "description": "Live system monitor for the DSH Web GUI: CPU, memory, storage (space, inodes, disk IO), network and process metrics as a sidebar panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs'"
  }
}
