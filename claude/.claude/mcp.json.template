{
  "_comment": "User-scope MCP servers for Claude Code. Tracked as a template because the live ~/.claude.json also holds OAuth/account/project state that is machine-local. claude/install.sh merges this 'mcpServers' block into ~/.claude.json. No Jev server is listed: the jev-router plugin that used to register one went with the broken jev CLI. 'pencil' is deliberately absent: it is a macOS-only app-bundle binary. 'genoffice' stays listed because Claude Code's mcpServers schema has no per-server enable flag, so the entry is inert until `genoffice install-cli` puts the CLI on PATH.",
  "mcpServers": {
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp",
      "args": []
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": false
    },
    "genoffice": {
      "command": "/Applications/GenOffice.app/Contents/Resources/cli/genoffice",
      "args": ["mcp"]
    }
  }
}
